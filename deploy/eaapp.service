[Unit]
Description=eaapp2.1 Next.js
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/eaapp/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
